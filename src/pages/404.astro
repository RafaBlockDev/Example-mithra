---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found — Mithra"
  description="The page you're looking for doesn't exist."
>
  <div class="min-h-screen bg-ibm-gray-100 flex flex-col items-center justify-center px-6 text-center">
    <svg width="48" height="48" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="mb-8" aria-hidden="true">
      <rect width="32" height="32" fill="#0f62fe"/>
      <path d="M8 8h4v16H8V8zm6 0h2l6 8-6 8h-2l6-8-6-8z" fill="white"/>
    </svg>

    <p class="text-ibm-blue text-sm font-medium tracking-widest uppercase mb-4">404</p>

    <h1 class="text-4xl sm:text-5xl font-light text-white mb-4">
      Page not found
    </h1>

    <p class="text-ibm-gray-40 text-lg max-w-md mb-10 leading-relaxed">
      The page you're looking for doesn't exist or has been moved.
    </p>

    <div class="flex flex-wrap gap-4 justify-center">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 bg-ibm-blue text-white text-sm font-medium rounded hover:bg-ibm-blue-hover transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-ibm-blue focus:ring-offset-2 focus:ring-offset-ibm-gray-100"
      >
        Back to home
      </a>
      <a
        href="/#contact"
        class="inline-flex items-center gap-2 px-6 py-3 bg-transparent text-white text-sm font-medium rounded border border-white/30 hover:border-white/60 hover:bg-white/10 transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-ibm-gray-100"
      >
        Contact us
      </a>
    </div>
  </div>
</Layout>
