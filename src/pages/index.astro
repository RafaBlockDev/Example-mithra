---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import HeroSection from '../components/HeroSection.astro';
import ClientLogos from '../components/ClientLogos.astro';
import StatsRow from '../components/StatsRow.astro';
import SolutionCard from '../components/SolutionCard.astro';
import FeatureBlock from '../components/FeatureBlock.astro';
import LocationCard from '../components/LocationCard.astro';
import IndustryCard from '../components/IndustryCard.astro';
import CTAForm from '../components/CTAForm.astro';
import Footer from '../components/Footer.astro';

// ── Copy & Content ──────────────────────────────────────────────────

const hero = {
  headline: 'Enterprise AI Solutions for Global Operations',
  subheadline:
    'Mithra accelerates enterprise transformation through intelligent software automation, AI implementation, and process intelligence — enabling organizations to scale operations across global markets with precision and speed.',
  primaryCTA: 'Start Free Consultation',
  secondaryCTA: 'See Platform Demo',
};

const stats = [
  {
    value: '500+',
    label: 'Enterprise Clients',
    description: 'Global companies trust Mithra for mission-critical operations',
  },
  {
    value: '2M+',
    label: 'Hours Automated',
    description: 'Cumulative operational hours reclaimed through AI-driven automation',
  },
  {
    value: '40+',
    label: 'Industry Verticals',
    description: 'Specialized solutions tailored to sector-specific challenges',
  },
];

const solutions = [
  {
    icon: 'automation',
    title: 'Software Automation',
    description:
      'Replace manual, repetitive workflows with intelligent automation pipelines. Reduce operational overhead, eliminate human error, and free your teams to focus on high-value strategic work.',
    features: [
      'End-to-end workflow automation',
      'Legacy system integration',
      'Real-time monitoring & alerting',
      'Auto-scaling infrastructure',
      '99.9% uptime SLA guarantee',
    ],
  },
  {
    icon: 'ai',
    title: 'AI Implementation',
    description:
      'Deploy production-grade AI models tailored to your business domain. From natural language processing to predictive analytics, Mithra delivers AI that drives measurable outcomes.',
    features: [
      'Custom model development & fine-tuning',
      'Seamless API & data integration',
      'Explainable AI with audit trails',
      'Continuous model monitoring',
      'Multi-language & multi-region support',
    ],
  },
  {
    icon: 'process',
    title: 'Process Intelligence',
    description:
      'Gain deep visibility into how your organization operates. Identify bottlenecks, map process flows, and apply AI-driven insights to continuously optimize performance at every level.',
    features: [
      'Process mining & visualization',
      'KPI tracking & benchmarking',
      'Predictive bottleneck detection',
      'Cross-department analytics',
      'Executive dashboards & reporting',
    ],
  },
];

const features = [
  {
    eyebrow: 'Unified AI Platform',
    title: 'One platform for every automation need',
    description:
      'The Mithra Platform unifies your entire automation stack — from data ingestion to model deployment — in a single, enterprise-grade environment. Eliminate tool sprawl and accelerate time-to-value.',
    bullets: [
      'Centralized pipeline orchestration across all business units',
      'Pre-built connectors for 200+ enterprise systems (SAP, Salesforce, Oracle)',
      'Role-based access control with enterprise SSO',
      'Real-time telemetry and audit logging',
    ],
    imageAlt: 'Mithra unified platform interface screenshot',
    imageLabel: 'Replace with platform UI screenshot — 560×400px',
    imageSrc: '/images/feature-unified-platform.jpg',
    reverse: false,
    accentColor: '#0f62fe',
  },
  {
    eyebrow: 'AI at Scale',
    title: 'Deploy intelligence across your entire organization',
    description:
      'Move beyond proof-of-concept. Mithra is built for production — with enterprise security, high availability, and the governance controls your compliance team demands.',
    bullets: [
      'Multi-tenant, multi-region deployment architecture',
      'SOC 2 Type II, ISO 27001, and GDPR compliant infrastructure',
      'Auto-scaling compute for peak demand periods',
      'AI model versioning with zero-downtime rollbacks',
    ],
    imageAlt: 'AI deployment and monitoring dashboard',
    imageLabel: 'Replace with AI monitoring screenshot — 560×400px',
    imageSrc: '/images/feature-ai-scale.jpg',
    reverse: true,
    accentColor: '#1192e8',
  },
  {
    eyebrow: 'Deep Analytics',
    title: 'Turn operational data into strategic advantage',
    description:
      'Every process generates data. Mithra transforms raw operational signals into actionable intelligence — surfacing insights that drive smarter decisions at every level of the organization.',
    bullets: [
      'Natural language query interface for non-technical stakeholders',
      'Automated anomaly detection with root cause analysis',
      'Predictive forecasting with 12-month horizons',
      'Configurable KPI alerts and executive digest reports',
    ],
    imageAlt: 'Analytics and business intelligence dashboard',
    imageLabel: 'Replace with analytics dashboard screenshot — 560×400px',
    imageSrc: '/images/feature-analytics.jpg',
    reverse: false,
    accentColor: '#009d9a',
  },
  {
    eyebrow: 'Enterprise Integration',
    title: 'Connect everything, break down every silo',
    description:
      'Mithra integrates with your existing technology investments — no rip-and-replace required. Our integration layer enables seamless data flow between legacy systems and modern cloud infrastructure.',
    bullets: [
      'REST, GraphQL, gRPC, and event-stream connectors',
      'iPaaS-compatible with MuleSoft, Boomi, and Workato',
      'Custom SDK for proprietary internal systems',
      'Data residency controls for regulatory compliance',
    ],
    imageAlt: 'Integration and connectivity architecture diagram',
    imageLabel: 'Replace with integration diagram — 560×400px',
    imageSrc: '/images/feature-integration.jpg',
    reverse: true,
    accentColor: '#8a3ffc',
  },
];

const locations = [
  {
    city: 'Mexico City',
    country: 'Mexico — Headquarters',
    description:
      'Our global headquarters and primary center of excellence. Home to product engineering, client success, and our LATAM operations hub serving clients across Latin America.',
    status: 'active' as const,
    address: 'Paseo de la Reforma 250, Cuauhtémoc, CDMX',
    focus: 'Global HQ · Product Engineering · LATAM Operations',
  },
  {
    city: 'Austin',
    country: 'United States',
    description:
      'North American R&D center and enterprise sales headquarters. Our Austin office drives product innovation and serves our growing base of Fortune 500 clients across the USA and Canada.',
    status: 'active' as const,
    address: '701 Brazos Street, Austin, TX 78701',
    focus: 'R&D Center · North American Sales · Enterprise Partnerships',
  },
  {
    city: 'Amsterdam',
    country: 'Europe — Launching Q3 2026',
    description:
      'Our European expansion hub, positioning Mithra to serve the EU market with full data residency compliance. Focused on financial services, healthcare, and manufacturing sectors across the continent.',
    status: 'q3-2026' as const,
    focus: 'EMEA Operations · GDPR Compliance Center · EU Market Expansion',
  },
  {
    city: 'Singapore',
    country: 'Asia-Pacific — Launching Q4 2026',
    description:
      "Our Asia-Pacific entry point, establishing Mithra's presence across Southeast Asia and regional partnerships. Focused on logistics, manufacturing, and cross-border commerce automation.",
    status: 'q4-2026' as const,
    focus: 'APAC Operations · Strategic Partnerships · Regional Expansion',
    imageSrc: '/images/location-asia-city.jpg',
  },
];

const industries = [
  {
    name: 'Financial Services',
    description: 'Automate compliance, risk scoring, and transaction processing at enterprise scale.',
    icon: 'finance',
  },
  {
    name: 'Healthcare',
    description: 'Streamline clinical workflows, patient data management, and regulatory reporting.',
    icon: 'healthcare',
  },
  {
    name: 'Manufacturing',
    description: 'Optimize production lines, quality control, and supply chain coordination.',
    icon: 'manufacturing',
  },
  {
    name: 'Logistics & Supply Chain',
    description: 'Enhance routing intelligence, inventory forecasting, and last-mile efficiency.',
    icon: 'logistics',
  },
  {
    name: 'Retail & Commerce',
    description: 'Personalize customer experiences and automate merchandising and fulfillment.',
    icon: 'retail',
  },
  {
    name: 'Energy & Utilities',
    description: 'Predict maintenance needs, optimize grid operations, and automate field workflows.',
    icon: 'energy',
  },
];

const cta = {
  headline: 'Ready to transform your operations?',
  subheadline:
    'Join 500+ enterprises already using Mithra to automate their most complex workflows. Schedule a free consultation with our solution architects today.',
  buttonLabel: 'Get Started',
};
---

<Layout>
  <!-- Navigation -->
  <Navigation />

  <!-- Hero -->
  <HeroSection
    headline={hero.headline}
    subheadline={hero.subheadline}
    primaryCTA={hero.primaryCTA}
    secondaryCTA={hero.secondaryCTA}
  />

  <!-- Client Logos Trust Bar -->
  <ClientLogos />

  <!-- Stats -->
  <StatsRow stats={stats} />

  <!-- Solutions -->
  <section id="solutions" class="py-20 lg:py-28 bg-white" aria-label="Our solutions">
    <div class="max-w-8xl mx-auto px-6 lg:px-8">
      <div class="max-w-2xl mb-12 lg:mb-16">
        <div class="inline-block px-3 py-1 bg-ibm-blue/10 text-ibm-blue text-xs font-medium tracking-wider uppercase rounded mb-4">
          Our Solutions
        </div>
        <h2 class="text-3xl lg:text-4xl font-light text-ibm-gray-100 mb-4">
          End-to-end capabilities for enterprise transformation
        </h2>
        <p class="text-ibm-gray-70 leading-relaxed">
          Mithra delivers a comprehensive suite of AI and automation capabilities — from initial process assessment through full-scale deployment and ongoing optimization.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {solutions.map((solution, index) => (
          <SolutionCard
            icon={solution.icon}
            title={solution.title}
            description={solution.description}
            features={solution.features}
            index={index}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Platform Features -->
  <section id="platform" class="py-20 lg:py-28 bg-ibm-gray-10" aria-label="Platform features">
    <div class="max-w-8xl mx-auto px-6 lg:px-8">
      <div class="max-w-2xl mb-12 lg:mb-20">
        <div class="inline-block px-3 py-1 bg-ibm-blue/10 text-ibm-blue text-xs font-medium tracking-wider uppercase rounded mb-4">
          The Platform
        </div>
        <h2 class="text-3xl lg:text-4xl font-light text-ibm-gray-100 mb-4">
          Built for enterprise, designed for scale
        </h2>
        <p class="text-ibm-gray-70 leading-relaxed">
          The Mithra Platform is the operational backbone for your AI transformation — engineered for the reliability, security, and performance that global enterprises demand.
        </p>
      </div>
      <div class="space-y-20 lg:space-y-28">
        {features.map((feature) => (
          <FeatureBlock
            eyebrow={feature.eyebrow}
            title={feature.title}
            description={feature.description}
            bullets={feature.bullets}
            imageAlt={feature.imageAlt}
            imageLabel={feature.imageLabel}
            reverse={feature.reverse}
            accentColor={feature.accentColor}
            imageSrc={feature.imageSrc}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Locations -->
  <section id="locations" class="py-20 lg:py-28 bg-white" aria-label="Global office locations">
    <div class="max-w-8xl mx-auto px-6 lg:px-8">
      <div class="max-w-2xl mb-12 lg:mb-16">
        <div class="inline-block px-3 py-1 bg-ibm-blue/10 text-ibm-blue text-xs font-medium tracking-wider uppercase rounded mb-4">
          Global Presence
        </div>
        <h2 class="text-3xl lg:text-4xl font-light text-ibm-gray-100 mb-4">
          Local expertise, global reach
        </h2>
        <p class="text-ibm-gray-70 leading-relaxed">
          Mithra operates from strategic hubs across the Americas, Europe, and Asia-Pacific — ensuring proximity to our clients and compliance with local regulatory requirements.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {locations.map((location) => (
          <LocationCard
            city={location.city}
            country={location.country}
            description={location.description}
            status={location.status}
            address={location.address}
            focus={location.focus}
            imageSrc={location.imageSrc}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Industries -->
  <section id="industries" class="py-20 lg:py-28 bg-ibm-gray-10" aria-label="Industries we serve">
    <div class="max-w-8xl mx-auto px-6 lg:px-8">
      <div class="max-w-2xl mb-12 lg:mb-16">
        <div class="inline-block px-3 py-1 bg-ibm-blue/10 text-ibm-blue text-xs font-medium tracking-wider uppercase rounded mb-4">
          Industries
        </div>
        <h2 class="text-3xl lg:text-4xl font-light text-ibm-gray-100 mb-4">
          Specialized for your sector
        </h2>
        <p class="text-ibm-gray-70 leading-relaxed">
          Mithra combines deep industry expertise with cutting-edge AI capabilities, delivering solutions that address the specific operational challenges of each sector.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-6">
        {industries.map((industry) => (
          <IndustryCard
            name={industry.name}
            description={industry.description}
            icon={industry.icon}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA / Contact -->
  <CTAForm
    headline={cta.headline}
    subheadline={cta.subheadline}
    buttonLabel={cta.buttonLabel}
  />

  <!-- Footer -->
  <Footer />
</Layout>
