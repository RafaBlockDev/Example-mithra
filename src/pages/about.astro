---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const values = [
  { title: 'Precision', description: 'We build software that works exactly as specified — no ambiguity, no approximation, no excuses.' },
  { title: 'Transparency', description: 'Our clients see every metric, every model decision, and every deployment log. No black boxes.' },
  { title: 'Scale', description: 'We design for enterprise load from day one. Every system we build must perform at global scale.' },
  { title: 'Partnership', description: 'We succeed when our clients succeed. Every engagement is structured around measurable outcomes.' },
];
---

<Layout title="About Mithra — Enterprise AI Solutions" description="Learn about Mithra's mission, leadership team, and the values that drive our global enterprise AI platform.">
  <Navigation />

  <!-- Hero -->
  <section class="pt-24 pb-16 bg-ibm-gray-100">
    <div class="max-w-8xl mx-auto px-6 lg:px-8 pt-8">
      <div class="max-w-3xl">
        <div class="inline-block px-3 py-1 bg-ibm-blue/20 border border-ibm-blue/30 rounded-full mb-6">
          <span class="text-xs font-medium text-ibm-blue-light tracking-wider uppercase">About</span>
        </div>
        <h1 class="text-5xl lg:text-6xl font-light text-white mb-6">
          We build AI that <span class="font-semibold text-ibm-blue">works at scale</span>
        </h1>
        <p class="text-xl text-ibm-gray-30 leading-relaxed max-w-2xl">
          Mithra was founded on a single conviction: that enterprise software should eliminate complexity, not create it. We apply that principle to every AI and automation system we deliver.
        </p>
      </div>
    </div>
  </section>

  <!-- Founded story -->
  <section class="py-20 bg-white">
    <div class="max-w-8xl mx-auto px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <div>
          <p class="text-sm font-medium text-ibm-blue tracking-wider uppercase mb-4">Our Story</p>
          <h2 class="text-3xl font-light text-ibm-gray-100 mb-6">Founded in Mexico City, operating globally</h2>
          <p class="text-ibm-gray-70 leading-relaxed mb-4">
            Mithra was founded in 2021 in Mexico City by a team of enterprise software engineers and AI researchers who saw a consistent gap in the market: organizations wanted to adopt AI but lacked the operational infrastructure to do so safely and at scale.
          </p>
          <p class="text-ibm-gray-70 leading-relaxed mb-4">
            We built the Mithra Platform to bridge that gap — a unified environment where enterprises can design, deploy, and monitor AI-powered workflows without requiring a team of data scientists for every initiative.
          </p>
          <p class="text-ibm-gray-70 leading-relaxed">
            Today, Mithra serves 500+ enterprise clients across 40+ industries, with active operations in Mexico and the United States, and expansion into Europe and Asia-Pacific underway.
          </p>
        </div>
        <div class="space-y-6">
          <img
            src="/images/about-team-meeting.jpg"
            alt="Mithra team collaborating in a meeting"
            class="rounded-lg shadow-ibm-lg w-full object-cover object-center"
            style="max-height: 260px;"
            loading="lazy"
            decoding="async"
          />
          <div class="grid grid-cols-2 gap-4">
            {[
              { value: '2021', label: 'Year founded' },
              { value: '500+', label: 'Enterprise clients' },
              { value: '40+', label: 'Industry verticals' },
              { value: '2M+', label: 'Hours automated' },
            ].map(stat => (
              <div class="bg-ibm-gray-10 rounded-lg p-6">
                <div class="text-3xl font-light text-ibm-blue mb-1">{stat.value}</div>
                <div class="text-sm text-ibm-gray-70">{stat.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section id="mission" class="py-20 bg-ibm-gray-10">
    <div class="max-w-8xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-sm font-medium text-ibm-blue tracking-wider uppercase mb-4">Mission</p>
        <h2 class="text-4xl font-light text-ibm-gray-100 mb-6">
          Making enterprise AI accessible, reliable, and measurable
        </h2>
        <p class="text-lg text-ibm-gray-70 leading-relaxed">
          Our mission is to give every enterprise — regardless of size, region, or technical maturity — the tools to automate their operations with AI-driven precision, delivering outcomes that compound over time.
        </p>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section id="values" class="py-20 bg-white">
    <div class="max-w-8xl mx-auto px-6 lg:px-8">
      <p class="text-sm font-medium text-ibm-blue tracking-wider uppercase mb-12">Our Values</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {values.map((value, i) => (
          <div class="border-t-2 border-ibm-blue pt-6">
            <div class="text-xs text-ibm-gray-50 mb-2">0{i + 1}</div>
            <h3 class="text-xl font-semibold text-ibm-gray-100 mb-3">{value.title}</h3>
            <p class="text-sm text-ibm-gray-70 leading-relaxed">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-ibm-blue">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-light text-white mb-4">Ready to work with us?</h2>
      <p class="text-ibm-blue-light mb-8">Schedule a free consultation with our solution architects.</p>
      <a href="/#contact" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-ibm-blue font-medium rounded hover:bg-ibm-gray-10 transition-colors duration-150">
        Start Free Consultation
      </a>
    </div>
  </section>

  <Footer />
</Layout>
