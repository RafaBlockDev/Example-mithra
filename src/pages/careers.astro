---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const openRoles = [
  { title: 'Senior AI Engineer', team: 'Engineering', location: 'Mexico City / Remote', type: 'Full-time' },
  { title: 'Platform Solutions Architect', team: 'Engineering', location: 'Austin, TX', type: 'Full-time' },
  { title: 'Enterprise Account Executive', team: 'Sales', location: 'Austin, TX', type: 'Full-time' },
  { title: 'ML Operations Engineer', team: 'Engineering', location: 'Remote (LATAM)', type: 'Full-time' },
  { title: 'Product Manager, Integrations', team: 'Product', location: 'Mexico City', type: 'Full-time' },
  { title: 'Customer Success Manager', team: 'Client Success', location: 'Austin, TX / Remote', type: 'Full-time' },
];

const benefits = [
  { icon: '🌎', title: 'Remote-first culture', description: 'Work from anywhere in LATAM or USA. Optional offices in Mexico City and Austin.' },
  { icon: '📈', title: 'Equity participation', description: 'All full-time employees participate in our employee stock option plan.' },
  { icon: '🎓', title: 'Learning budget', description: 'USD $2,000/year for conferences, courses, and certifications.' },
  { icon: '🏥', title: 'Health coverage', description: 'Comprehensive medical, dental, and vision for you and your dependents.' },
  { icon: '🕐', title: 'Flexible hours', description: 'Async-first. We care about output, not hours behind a screen.' },
  { icon: '✈️', title: 'Team offsites', description: 'Quarterly in-person gatherings across our global offices.' },
];
---

<Layout title="Careers at Mithra — Join Our Team" description="Join Mithra and help build the enterprise AI platform trusted by 500+ global companies. Open roles in engineering, sales, and product.">
  <Navigation />

  <!-- Hero -->
  <section class="pt-24 pb-16 bg-ibm-gray-100">
    <div class="max-w-8xl mx-auto px-6 lg:px-8 pt-8">
      <div class="max-w-3xl">
        <div class="inline-block px-3 py-1 bg-ibm-blue/20 border border-ibm-blue/30 rounded-full mb-6">
          <span class="text-xs font-medium text-ibm-blue-light tracking-wider uppercase">Careers</span>
        </div>
        <h1 class="text-5xl lg:text-6xl font-light text-white mb-6">
          Build the future of <span class="font-semibold text-ibm-blue">enterprise AI</span>
        </h1>
        <p class="text-xl text-ibm-gray-30 leading-relaxed">
          We're a distributed team of engineers, researchers, and operators solving the hardest problems in enterprise automation. Remote-first, outcome-focused, globally minded.
        </p>
        <div class="mt-10 rounded-lg overflow-hidden shadow-ibm-xl max-w-2xl">
          <img
            src="/images/careers-remote-work.jpg"
            alt="Remote-first work environment at Mithra"
            class="w-full object-cover object-center"
            style="max-height: 280px;"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Open Roles -->
  <section class="py-20 bg-white">
    <div class="max-w-8xl mx-auto px-6 lg:px-8">
      <p class="text-sm font-medium text-ibm-blue tracking-wider uppercase mb-4">Open Positions</p>
      <h2 class="text-3xl font-light text-ibm-gray-100 mb-10">{openRoles.length} open roles</h2>
      <div class="space-y-3">
        {openRoles.map(role => (
          <div class="group border border-ibm-gray-20 rounded-lg p-6 hover:border-ibm-blue hover:shadow-ibm-md transition-all duration-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h3 class="font-semibold text-ibm-gray-100 group-hover:text-ibm-blue transition-colors">{role.title}</h3>
              <div class="flex flex-wrap gap-3 mt-2">
                <span class="text-xs text-ibm-gray-60 bg-ibm-gray-10 px-2 py-0.5 rounded">{role.team}</span>
                <span class="text-xs text-ibm-gray-60">{role.location}</span>
                <span class="text-xs text-ibm-gray-60">{role.type}</span>
              </div>
            </div>
            <a href="/#contact" class="flex-shrink-0 inline-flex items-center gap-1.5 px-4 py-2 text-sm text-ibm-blue border border-ibm-blue rounded hover:bg-ibm-blue hover:text-white transition-colors duration-150">
              Apply
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path fill-rule="evenodd" d="M4.5 11.5A.5.5 0 015 11h5.793L5.146 5.354a.5.5 0 11.708-.708l6 6a.5.5 0 010 .708l-6 6a.5.5 0 01-.708-.708L10.293 11.5H5a.5.5 0 01-.5-.5z"/></svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="py-20 bg-ibm-gray-10">
    <div class="max-w-8xl mx-auto px-6 lg:px-8">
      <p class="text-sm font-medium text-ibm-blue tracking-wider uppercase mb-4">Benefits</p>
      <h2 class="text-3xl font-light text-ibm-gray-100 mb-10">What we offer</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {benefits.map(benefit => (
          <div class="bg-white border border-ibm-gray-20 rounded-lg p-6">
            <div class="text-2xl mb-3" aria-hidden="true">{benefit.icon}</div>
            <h3 class="font-semibold text-ibm-gray-100 mb-2">{benefit.title}</h3>
            <p class="text-sm text-ibm-gray-70 leading-relaxed">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-ibm-blue">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-light text-white mb-4">Don't see your role?</h2>
      <p class="text-ibm-blue-light mb-8">Send us your CV and we'll keep you in mind for future openings.</p>
      <a href="/#contact" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-ibm-blue font-medium rounded hover:bg-ibm-gray-10 transition-colors duration-150">
        Get in touch
      </a>
    </div>
  </section>

  <Footer />
</Layout>
