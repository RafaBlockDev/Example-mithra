---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const docSections = [
  {
    category: 'Getting Started',
    icon: 'M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5',
    articles: [
      { title: 'Platform Overview', description: 'Understand the core architecture of the Mithra Platform.' },
      { title: 'Quick Start Guide', description: 'Set up your first automated workflow in under 10 minutes.' },
      { title: 'Authentication & API Keys', description: 'Generate and manage your API credentials securely.' },
      { title: 'Workspace Setup', description: 'Configure your workspace, teams, and permissions.' },
    ],
  },
  {
    category: 'Workflows',
    icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
    articles: [
      { title: 'Workflow Builder', description: 'Visual drag-and-drop interface for building automation pipelines.' },
      { title: 'Triggers & Schedules', description: 'Configure event-driven and time-based workflow triggers.' },
      { title: 'Conditional Logic', description: 'Add branching and conditional paths to your workflows.' },
      { title: 'Error Handling', description: 'Set retry policies, fallbacks, and alerting for failed steps.' },
    ],
  },
  {
    category: 'AI & Models',
    icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
    articles: [
      { title: 'AI Model Catalog', description: 'Browse and deploy pre-built models for common enterprise tasks.' },
      { title: 'Custom Model Training', description: 'Fine-tune models on your own data using the Mithra ML toolkit.' },
      { title: 'Model Versioning', description: 'Manage, compare, and roll back model versions safely.' },
      { title: 'Inference API', description: 'Call deployed models via REST API from any system.' },
    ],
  },
  {
    category: 'Integrations',
    icon: 'M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1',
    articles: [
      { title: 'Integration Hub', description: 'Browse 200+ native connectors and configure authentication.' },
      { title: 'Webhooks', description: 'Send and receive events via webhooks with payload validation.' },
      { title: 'Custom SDK', description: 'Build connectors for proprietary internal systems.' },
      { title: 'iPaaS Connectors', description: 'Use Mithra alongside MuleSoft, Boomi, or Workato.' },
    ],
  },
];
---

<Layout title="Documentation — Mithra Platform" description="Official Mithra platform documentation. Get started with workflows, AI models, integrations, and the API reference.">
  <Navigation />

  <section class="pt-24 pb-16 bg-ibm-gray-100">
    <div class="max-w-8xl mx-auto px-6 lg:px-8 pt-8">
      <div class="max-w-3xl">
        <div class="inline-block px-3 py-1 bg-ibm-blue/20 border border-ibm-blue/30 rounded-full mb-6">
          <span class="text-xs font-medium text-ibm-blue-light tracking-wider uppercase">Documentation</span>
        </div>
        <h1 class="text-5xl font-light text-white mb-6">
          Mithra <span class="font-semibold text-ibm-blue">Docs</span>
        </h1>
        <p class="text-xl text-ibm-gray-30 leading-relaxed mb-8">
          Everything you need to build, deploy, and manage AI-powered workflows on the Mithra Platform.
        </p>
        <div class="relative max-w-xl">
          <label for="docs-search" class="sr-only">Search documentation</label>
          <input
            id="docs-search"
            type="search"
            placeholder="Search documentation..."
            class="w-full px-4 py-3 pl-10 bg-white/10 border border-white/20 rounded text-white placeholder-ibm-gray-50 text-sm focus:outline-none focus:border-ibm-blue focus:ring-1 focus:ring-ibm-blue"
          />
          <svg class="absolute left-3 top-3.5 w-4 h-4 text-ibm-gray-50" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-8xl mx-auto px-6 lg:px-8 space-y-16">
      {docSections.map(section => (
        <div>
          <div class="flex items-center gap-3 mb-6">
            <div class="w-8 h-8 bg-ibm-blue/10 rounded-lg flex items-center justify-center" aria-hidden="true">
              <svg class="w-4 h-4 text-ibm-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={section.icon}/>
              </svg>
            </div>
            <h2 class="text-lg font-semibold text-ibm-gray-100">{section.category}</h2>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {section.articles.map(article => (
              <a href="/#contact" class="group border border-ibm-gray-20 rounded-lg p-5 hover:border-ibm-blue hover:shadow-ibm-md transition-all duration-200 block">
                <h3 class="font-medium text-ibm-gray-100 mb-2 group-hover:text-ibm-blue transition-colors text-sm">{article.title}</h3>
                <p class="text-xs text-ibm-gray-60 leading-relaxed">{article.description}</p>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="py-20 bg-ibm-gray-10">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-light text-ibm-gray-100 mb-4">Need help?</h2>
      <p class="text-ibm-gray-70 mb-8">Our engineering team is available via chat and email for Professional and Enterprise customers.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/#contact" class="inline-flex items-center gap-2 px-6 py-3 bg-ibm-blue text-white font-medium rounded hover:bg-ibm-blue-hover transition-colors">
          Contact support
        </a>
        <a href="/pricing" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-ibm-gray-100 font-medium rounded border border-ibm-gray-20 hover:border-ibm-blue transition-colors">
          View pricing
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
