---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

const challenges = [
  {
    number: '01',
    title: 'Regulatory Compliance Burden',
    description: 'Financial institutions spend hundreds of thousands of hours annually reconciling transactions, producing audit trails, and manually verifying adherence to constantly evolving frameworks like Basel III, DORA, and MiFID II. Every failed audit is a liability.',
  },
  {
    number: '02',
    title: 'Fraud Detection Latency',
    description: 'Legacy rule-based fraud systems produce high false-positive rates and miss novel attack vectors. Decisions made in seconds require intelligence that batch-processing pipelines simply cannot provide — leaving both customers and institutions exposed.',
  },
  {
    number: '03',
    title: 'Manual Regulatory Reporting',
    description: 'Producing regulatory filings — from FINRA to the SEC to local central banks — consumes entire teams for weeks at a time. Data is scattered across systems, formats are inconsistent, and human error introduces unacceptable risk.',
  },
];

const solutions = [
  {
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
    title: 'Automated Compliance Monitoring',
    description: 'Mithra\'s compliance engine continuously monitors every transaction and workflow against your regulatory ruleset in real time. Deviations are flagged instantly with full audit context — no manual review queue required.',
  },
  {
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
    title: 'Real-Time Fraud Scoring ML',
    description: 'Our machine learning models score every transaction at sub-200ms latency, combining behavioral signals, network graph analysis, and historical patterns to catch fraud before it clears — without disrupting legitimate customers.',
  },
  {
    icon: 'M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
    title: 'Regulatory Report Generation',
    description: 'Automated pipelines aggregate data from all your source systems, normalize it into required formats, and generate submission-ready regulatory reports — cutting filing time from weeks to hours across 40+ supported frameworks.',
  },
  {
    icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
    title: 'Audit Trail & Evidence Management',
    description: 'Every decision made by the Mithra Platform is logged, timestamped, and stored in immutable audit records. Give examiners complete transparency and reduce the time spent preparing for regulatory reviews by up to 80%.',
  },
];

const stats = [
  { value: '70%', label: 'Reduction in compliance costs' },
  { value: '200ms', label: 'Fraud detection latency' },
  { value: '40+', label: 'Regulatory frameworks supported' },
  { value: '80%', label: 'Faster audit preparation' },
];
---

<Layout
  title="Financial Services AI Solutions — Mithra"
  description="Mithra delivers enterprise AI for financial services: automated compliance monitoring, real-time fraud detection, and regulatory report generation across 40+ frameworks."
>
  <Navigation />

  <!-- Hero -->
  <section class="pt-24 pb-20 bg-ibm-gray-100 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-0 right-0 w-1/2 h-full opacity-5"
        style="background: linear-gradient(135deg, #0f62fe 0%, transparent 70%);">
      </div>
      <div class="absolute bottom-0 left-0 w-px h-full bg-ibm-blue/20"></div>
    </div>
    <div class="max-w-8xl mx-auto px-6 lg:px-8 pt-8 relative">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-6">
          <a href="/" class="text-xs text-ibm-gray-50 hover:text-ibm-gray-30 transition-colors">Mithra</a>
          <span class="text-ibm-gray-70 text-xs" aria-hidden="true">/</span>
          <a href="/#industries" class="text-xs text-ibm-gray-50 hover:text-ibm-gray-30 transition-colors">Industries</a>
          <span class="text-ibm-gray-70 text-xs" aria-hidden="true">/</span>
          <span class="text-xs text-ibm-gray-40">Financial Services</span>
        </div>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-ibm-blue/20 border border-ibm-blue/30 rounded-full mb-6">
          <svg class="w-3.5 h-3.5 text-ibm-blue-light" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span class="text-xs font-medium text-ibm-blue-light tracking-wider uppercase">Financial Services</span>
        </div>
        <h1 class="text-5xl lg:text-6xl font-light text-white mb-6 leading-tight">
          AI-powered compliance and<br/>
          <span class="font-semibold text-ibm-blue">fraud intelligence</span>
        </h1>
        <p class="text-xl text-ibm-gray-30 leading-relaxed max-w-2xl mb-10">
          Mithra helps banks, asset managers, and fintech companies automate regulatory compliance, detect fraud in real time, and generate submission-ready reports — at enterprise scale.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a
            href="/#contact"
            class="inline-flex items-center gap-2 px-6 py-3 bg-ibm-blue text-white font-medium rounded hover:bg-ibm-blue-hover transition-colors duration-150"
          >
            Schedule a Demo
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a
            href="/#solutions"
            class="inline-flex items-center gap-2 px-6 py-3 text-ibm-blue-light border border-ibm-blue/40 rounded hover:bg-ibm-blue/10 transition-colors duration-150"
          >
            View Platform Overview
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Challenges -->
  <section class="py-20 bg-white">
    <div class="max-w-8xl mx-auto px-6 lg:px-8">
      <div class="mb-14">
        <p class="text-sm font-medium text-ibm-blue tracking-wider uppercase mb-3">Challenges We Solve</p>
        <h2 class="text-3xl font-light text-ibm-gray-100 max-w-2xl">
          The compliance and fraud problems costing financial institutions millions every year
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {challenges.map((challenge) => (
          <div class="border border-ibm-gray-20 rounded-lg p-8 hover:border-ibm-blue hover:shadow-ibm-lg transition-all duration-300 group">
            <div class="text-xs font-medium text-ibm-blue tracking-widest mb-4 font-mono">{challenge.number}</div>
            <h3 class="text-xl font-semibold text-ibm-gray-100 mb-4 group-hover:text-ibm-blue transition-colors">{challenge.title}</h3>
            <p class="text-sm text-ibm-gray-70 leading-relaxed">{challenge.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Solutions -->
  <section class="py-20 bg-ibm-gray-10">
    <div class="max-w-8xl mx-auto px-6 lg:px-8">
      <div class="mb-14">
        <p class="text-sm font-medium text-ibm-blue tracking-wider uppercase mb-3">Our Solutions</p>
        <h2 class="text-3xl font-light text-ibm-gray-100 max-w-2xl">
          Purpose-built AI for regulated financial environments
        </h2>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        {solutions.map((solution) => (
          <div class="bg-white border border-ibm-gray-20 rounded-lg p-8 flex gap-6 hover:border-ibm-blue hover:shadow-ibm-md transition-all duration-300">
            <div class="flex-shrink-0 w-12 h-12 bg-ibm-blue/10 rounded-lg flex items-center justify-center" aria-hidden="true">
              <svg class="w-6 h-6 text-ibm-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={solution.icon}/>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-ibm-gray-100 mb-2">{solution.title}</h3>
              <p class="text-sm text-ibm-gray-70 leading-relaxed">{solution.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-20 bg-ibm-blue">
    <div class="max-w-8xl mx-auto px-6 lg:px-8">
      <p class="text-sm font-medium text-ibm-blue-light tracking-wider uppercase mb-12 text-center">Results at Scale</p>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
        {stats.map((stat) => (
          <div class="text-center">
            <div class="text-4xl lg:text-5xl font-light text-white mb-2">{stat.value}</div>
            <div class="text-sm text-ibm-blue-light">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-ibm-gray-100">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <p class="text-sm font-medium text-ibm-blue tracking-wider uppercase mb-4">Get Started</p>
      <h2 class="text-4xl font-light text-white mb-4">
        Ready to modernize your compliance operations?
      </h2>
      <p class="text-ibm-gray-30 text-lg mb-10 max-w-2xl mx-auto">
        Our financial services team will map your current compliance workflows and show you exactly where Mithra eliminates cost and risk.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/#contact"
          class="inline-flex items-center gap-2 px-8 py-4 bg-ibm-blue text-white font-medium rounded hover:bg-ibm-blue-hover transition-colors duration-150 text-base"
        >
          Start Free Consultation
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a
          href="/industries/healthcare"
          class="inline-flex items-center gap-2 px-6 py-4 text-ibm-gray-30 border border-ibm-gray-70 rounded hover:border-ibm-gray-40 hover:text-white transition-colors duration-150 text-base"
        >
          Explore Healthcare Solutions
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
