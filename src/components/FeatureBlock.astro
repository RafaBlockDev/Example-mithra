---
export interface Props {
  eyebrow: string;
  title: string;
  description: string;
  bullets: string[];
  imageAlt: string;
  imageLabel: string;
  imageSrc?: string;
  reverse?: boolean;
  accentColor?: string;
}

const {
  eyebrow,
  title,
  description,
  bullets,
  imageAlt,
  imageLabel,
  imageSrc,
  reverse = false,
  accentColor = '#0f62fe',
} = Astro.props;
---

<div class={`grid lg:grid-cols-2 gap-12 lg:gap-20 items-center ${reverse ? 'lg:grid-flow-dense' : ''}`}>
  <div class={reverse ? 'lg:col-start-2' : ''}>
    <div class="inline-block px-3 py-1 bg-ibm-blue/10 text-ibm-blue text-xs font-medium tracking-wider uppercase rounded mb-4">
      {eyebrow}
    </div>
    <h3 class="text-3xl font-light text-ibm-gray-100 mb-4">
      {title}
    </h3>
    <p class="text-ibm-gray-70 leading-relaxed mb-6">
      {description}
    </p>
    <ul class="space-y-3" role="list">
      {bullets.map((bullet) => (
        <li class="flex items-start gap-3">
          <div class="w-5 h-5 rounded-full bg-ibm-blue/10 flex items-center justify-center flex-shrink-0 mt-0.5" aria-hidden="true">
            <svg class="w-3 h-3 text-ibm-blue" viewBox="0 0 12 12" fill="currentColor">
              <path d="M10.28 2.28L3.989 8.575 1.695 6.28A1 1 0 00.28 7.695l3 3a1 1 0 001.414 0l7-7A1 1 0 0010.28 2.28z"/>
            </svg>
          </div>
          <span class="text-sm text-ibm-gray-70 leading-relaxed">{bullet}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class={`relative ${reverse ? 'lg:col-start-1 lg:row-start-1' : ''}`} role="img" aria-label={imageAlt}>
    <div class="relative rounded-lg overflow-hidden shadow-ibm-xl">
      {imageSrc ? (
        <img
          src={imageSrc}
          alt={imageAlt}
          class="rounded-lg shadow-ibm-xl w-full object-cover object-center"
          style="max-height: 400px;"
          loading="lazy"
          decoding="async"
          width="560"
          height="400"
        />
      ) : (
        <svg
          width="100%"
          viewBox="0 0 560 400"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-label={imageAlt}
          role="presentation"
        >
          <rect width="560" height="400" fill="#f4f4f4"/>
          <rect x="0" y="0" width="560" height="4" fill={accentColor}/>
          <rect x="40" y="60" width="480" height="280" rx="6" fill="#e0e0e0"/>
          <text x="280" y="368" text-anchor="middle" fill="#8d8d8d" font-size="11" font-family="IBM Plex Sans, sans-serif">
            {imageLabel}
          </text>
        </svg>
      )}
    </div>
    <div class="absolute -bottom-4 -right-4 w-32 h-32 rounded-full blur-2xl opacity-20" style={`background: ${accentColor}`} aria-hidden="true"></div>
  </div>
</div>
