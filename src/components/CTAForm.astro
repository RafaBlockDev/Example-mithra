---
export interface Props {
  headline: string;
  subheadline: string;
  buttonLabel: string;
}

const { headline, subheadline, buttonLabel } = Astro.props;
---

<section
  id="contact"
  class="bg-ibm-gray-100 py-20 lg:py-28"
  aria-label="Contact and consultation request"
>
  <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-ibm-blue/20 border border-ibm-blue/30 rounded-full mb-6">
      <span class="text-xs font-medium text-ibm-blue-light tracking-wider uppercase">Free Consultation</span>
    </div>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-white mb-4">
      {headline}
    </h2>
    <p class="text-lg text-ibm-gray-30 mb-10 max-w-2xl mx-auto leading-relaxed">
      {subheadline}
    </p>

    <form
      id="consultation-form"
      class="max-w-xl mx-auto"
      novalidate
      aria-label="Request free consultation form"
    >
      <div class="flex flex-col sm:flex-row gap-3">
        <div class="flex-grow">
          <label for="email-input" class="sr-only">Business email address</label>
          <input
            type="email"
            id="email-input"
            name="email"
            placeholder="your@company.com"
            required
            autocomplete="email"
            class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded text-white placeholder-ibm-gray-50 text-sm focus:outline-none focus:border-ibm-blue focus:ring-1 focus:ring-ibm-blue transition-colors"
            aria-required="true"
            aria-describedby="email-error"
          />
          <p id="email-error" class="hidden mt-1 text-xs text-ibm-red text-left" role="alert" aria-live="polite">
            Please enter a valid business email address.
          </p>
        </div>
        <button
          type="submit"
          class="px-6 py-3 bg-ibm-blue text-white text-sm font-medium rounded hover:bg-ibm-blue-hover transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-ibm-blue focus:ring-offset-2 focus:ring-offset-ibm-gray-100 whitespace-nowrap disabled:opacity-50 disabled:cursor-not-allowed"
          aria-label="Submit consultation request"
        >
          {buttonLabel}
        </button>
      </div>
      <p class="text-xs text-ibm-gray-50 mt-3">
        No commitment required. Our team typically responds within 24 hours.
      </p>
      <div
        id="success-message"
        class="hidden mt-4 p-4 bg-ibm-green/20 border border-ibm-green/30 rounded text-sm text-green-300"
        role="alert"
        aria-live="polite"
      >
        Thank you! We'll be in touch within 24 hours.
      </div>
    </form>

    <div class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
      {[
        { icon: 'shield', text: 'Enterprise Security', sub: 'SOC 2 Type II compliant' },
        { icon: 'clock', text: '24-hour Response', sub: 'Guaranteed reply SLA' },
        { icon: 'star', text: 'No Commitment', sub: 'Free initial consultation' },
      ].map((item) => (
        <div class="flex flex-col items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-ibm-blue/20 flex items-center justify-center" aria-hidden="true">
            {item.icon === 'shield' && (
              <svg class="w-4 h-4 text-ibm-blue" viewBox="0 0 16 16" fill="currentColor">
                <path d="M8 1a.5.5 0 01.187.036l7 2.667A.5.5 0 0115.5 4v.5c0 5.523-3.105 9.384-7.313 10.947A.5.5 0 018 15.5a.5.5 0 01-.187-.053C3.605 13.884.5 10.023.5 4.5V4a.5.5 0 01.313-.464l7-2.667A.5.5 0 018 1zm0 1.025L1.5 4.438V4.5c0 5.06 2.79 8.572 6.5 10.047C11.71 13.072 14.5 9.56 14.5 4.5v-.062L8 2.025z"/>
              </svg>
            )}
            {item.icon === 'clock' && (
              <svg class="w-4 h-4 text-ibm-blue" viewBox="0 0 16 16" fill="currentColor">
                <path d="M8 3.5a.5.5 0 00-1 0V9a.5.5 0 00.252.434l3.5 2a.5.5 0 00.496-.868L8 8.71V3.5z"/>
                <path d="M8 16A8 8 0 108 0a8 8 0 000 16zm7-8A7 7 0 111 8a7 7 0 0114 0z"/>
              </svg>
            )}
            {item.icon === 'star' && (
              <svg class="w-4 h-4 text-ibm-blue" viewBox="0 0 16 16" fill="currentColor">
                <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
              </svg>
            )}
          </div>
          <div>
            <div class="text-sm font-medium text-white">{item.text}</div>
            <div class="text-xs text-ibm-gray-50">{item.sub}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('consultation-form') as HTMLFormElement;
  const emailInput = document.getElementById('email-input') as HTMLInputElement;
  const emailError = document.getElementById('email-error');
  const successMessage = document.getElementById('success-message');
  const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement;

  const isValidEmail = (email: string) =>
    /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email);

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = emailInput?.value.trim();

    if (!email || !isValidEmail(email)) {
      emailError?.classList.remove('hidden');
      emailInput?.setAttribute('aria-invalid', 'true');
      emailInput?.focus();
      return;
    }

    emailError?.classList.add('hidden');
    emailInput?.setAttribute('aria-invalid', 'false');

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';
    }

    setTimeout(() => {
      successMessage?.classList.remove('hidden');
      form.reset();
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Get Started';
      }
    }, 1000);
  });

  emailInput?.addEventListener('input', () => {
    if (emailInput.value && isValidEmail(emailInput.value)) {
      emailError?.classList.add('hidden');
      emailInput.setAttribute('aria-invalid', 'false');
    }
  });
</script>
