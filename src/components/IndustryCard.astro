---
export interface Props {
  name: string;
  description: string;
  icon: string;
  href?: string;
}

const { name, description, icon, href = '#contact' } = Astro.props;

const icons: Record<string, string> = {
  finance: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z',
  healthcare: 'M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l7.59-7.59L21 8l-9 9z',
  manufacturing: 'M13 3v.27l2 2V5h4v4h-.27l2 2H21v6h-1.27l2 2H22v2H2v-2h.27l2-2H3v-6h1.27l2-2H6V5h4v.27l2-2V3h1zm1 2h-4v1.27L7.27 9H5v4.27l-2.27 2.27V17h18.54l-2.27-2.46V13h-2.27L13 10.27V5z',
  logistics: 'M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z',
  retail: 'M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96C5 16.1 6.1 17 7 17h14v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63H19c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1 1 0 0023.46 4H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z',
  energy: 'M7 2v11h3v9l7-12h-4l4-8z',
};
---

<a
  href={href}
  class="group block bg-white border border-ibm-gray-20 rounded-lg p-6 hover:border-ibm-blue hover:shadow-ibm-lg transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-ibm-blue focus:ring-offset-2"
  aria-label={`Learn about Mithra's ${name} solutions`}
>
  <div class="flex items-start gap-4">
    <div
      class="w-10 h-10 rounded-lg bg-ibm-blue/10 flex items-center justify-center flex-shrink-0 group-hover:bg-ibm-blue transition-colors duration-300"
      aria-hidden="true"
    >
      <svg
        class="w-5 h-5 text-ibm-blue group-hover:text-white transition-colors duration-300"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d={icons[icon.toLowerCase()] || icons.finance}/>
      </svg>
    </div>
    <div>
      <h3 class="text-base font-semibold text-ibm-gray-100 mb-1 group-hover:text-ibm-blue transition-colors duration-300">
        {name}
      </h3>
      <p class="text-sm text-ibm-gray-60 leading-relaxed">{description}</p>
    </div>
  </div>
</a>
